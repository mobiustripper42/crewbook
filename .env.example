# BrewBoat environment variables
#
# Copy to `.env.local` for local dev. For Vercel, set these in
# Project Settings → Environment Variables, scoped to the right env
# (Production, Preview, or both).
#
# Legend: [prod] = different value per environment, [shared] = same everywhere

# ─── Supabase ─────────────────────────────────────────────────────────
# Local dev: get values from `supabase status` after `supabase start`.
# Production (Vercel): point at the BrewBoat Supabase project.
NEXT_PUBLIC_SUPABASE_URL=                  # [prod] e.g. https://abc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=             # [prod] anon/publishable key
SUPABASE_SERVICE_ROLE_KEY=                 # [prod] service role — Production scope ONLY in Vercel (bypasses RLS; do not set for Preview)

# ─── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000 # [prod] e.g. https://brewboat.vercel.app

# ─── Notifications (Phase 5.7) ────────────────────────────────────────
# Resend handles magic-link emails (DEC-104) and shift-posted alerts.
# Set NOTIFICATIONS_ENABLED=false in dev/CI to skip real sends.
NOTIFICATIONS_ENABLED=false                # [prod] 'true' in prod, 'false' in preview/dev/CI
# RESEND_API_KEY=                          # [prod] re_… from resend.com — wire when Phase 5.7 lands

# ─── Agents (Phases 2, 3) ─────────────────────────────────────────────
# Anthropic Claude Sonnet — shift generation + staff assignment.
# ANTHROPIC_API_KEY=                       # [prod] sk-ant-… — wire when Phase 2.1 lands

# ─── Xola (Phases 1, 4) ───────────────────────────────────────────────
# Sandbox first; prod cutover in Phase 6.4. App Store registration
# required before the key works (DEC-111). See DEC-114 + docs/XOLA_INTEGRATION.md.
XOLA_ENV=sandbox                           # [prod] 'sandbox' or 'prod' — selects base URL + which plugin key to read
# XOLA_PLUGIN_KEY=                         # [prod] sandbox plugin user key — used when XOLA_ENV=sandbox
# XOLA_PROD_PLUGIN_KEY=                    # [prod] production plugin user key — used when XOLA_ENV=prod (Phase 6.4)
# XOLA_SELLER_ID=                          # [prod] target seller (BrewBoat Cleveland). Sandbox: 69dfbe5744e51dad92085ae5
